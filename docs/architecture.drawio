        </mxCell>

        <!-- Step 6: Assemble -->
        <mxCell id="assemble" value="Step 6: FFmpeg Assembly&#xa;(image + audio segment concat&#xa;audio duration + 0.3s padding&#xa;libx264, aac, yuv420p)&#xa;Candidate: video.mp4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1150" y="230" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Step 7: Eval Gates -->
        <mxCell id="eval" value="Step 7: Evaluation Gates&#xa;1. Duration &lt;= 60s&#xa;2. Secret leaks = 0&#xa;3. Groundedness = 100%&#xa;4. Command validity = 100%&#xa;5. Text overflow = 0 scenes&#xa;6. Audio drift &lt;= 0.5s" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1370" y="190" width="200" height="160" as="geometry" />
        </mxCell>

