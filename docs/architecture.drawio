          <mxGeometry x="480" y="230" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Step 3: Verify & Revise -->
        <mxCell id="verify" value="Step 3: Verify &amp; Revise Loop&#xa;(Deterministic checks:&#xa;verbatim quote grounding,&#xa;no secrets, 30-58s duration,&#xa;max 2 retry feedback loops)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="200" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- Retry Loop -->
        <mxCell id="retry_edge" value="Failed check (errors fed back)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;dashed=1;strokeColor=#b85450;" edge="1" source="verify" target="plan" parent="1">
