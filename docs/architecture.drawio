        <!-- Step 4: TTS -->
        <mxCell id="tts" value="Step 4: TTS Generation&#xa;(silent WAV baseline /&#xa;edge-tts / espeak-ng)&#xa;Output: audio/*.wav" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="940" y="160" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- Step 5: Render -->
        <mxCell id="render" value="Step 5: Frame Renderer&#xa;(Playwright Chromium default&#xa;Pillow layout fallback&#xa;overflow detection + badges)&#xa;Output: frames/*.png" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
